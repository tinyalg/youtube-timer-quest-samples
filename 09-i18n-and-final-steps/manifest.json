{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "0.8.0",
  "description": "__MSG_appDesc__",
  "icons": {
    "128": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "default_locale": "en",
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ], 
  "host_permissions": [],
  "action": {
    "default_icon": "icon.png",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
