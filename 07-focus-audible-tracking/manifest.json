{
  "manifest_version": 3,
  "name": "Universal Timer",
  "version": "0.6.0",
  "description": "YouTubeの視聴時間を計測します",
  "icons": {
    "128": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "tabs"
  ], 
  "host_permissions": [],
  "action": {
    "default_icon": "icon.png",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
